# Copy to a local untracked .env file and replace both values.
RINGSHIELD_DATABASE_URL=postgresql+psycopg://ringshield_runtime:replace-me@localhost:5432/ringshield?options=-c%20role%3Dringshield_api
RINGSHIELD_AUTH_DATABASE_URL=postgresql+psycopg://ringshield_auth_login:replace-me@localhost:5432/ringshield?options=-c%20role%3Dringshield_auth
RINGSHIELD_LOADER_DATABASE_URL=postgresql+psycopg://ringshield_loader_login:replace-me@localhost:5432/ringshield?options=-c%20role%3Dringshield_loader
RINGSHIELD_SIMULATOR_DATABASE_URL=postgresql+psycopg://ringshield_simulator_login:replace-me@localhost:5432/ringshield?options=-c%20role%3Dringshield_simulator
RINGSHIELD_MIGRATION_DATABASE_URL=postgresql+psycopg://ringshield_owner_login:replace-me@localhost:5432/ringshield?options=-c%20role%3Dringshield_owner
RINGSHIELD_DATABASE_ADMIN_PSQL_URL=postgresql://ringshield_admin:replace-me@localhost:5432/ringshield
RINGSHIELD_JWT_SECRET=replace-with-at-least-32-random-characters
RINGSHIELD_TIME_ORIGIN_UTC=
RINGSHIELD_CURRENCY_MAP=data/processed/currency_map.json
RINGSHIELD_PAYMENT_FORMAT_MAP=data/processed/payment_format_map.json
RINGSHIELD_API_URL=http://127.0.0.1:8000
RINGSHIELD_ARTIFACT_DIR=models/artifacts
# API command from repository root: uvicorn api.main:app --app-dir platform
