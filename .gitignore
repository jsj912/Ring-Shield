# ============================================
# DATA — raw + processed (too large for git)
# ============================================
data/raw/
data/processed/
data/platform_demo/
data/platform_tenant_runs/

# ============================================
# MODEL ARTIFACTS — trained models, predictions
# ============================================
*.pkl
*.pt
*.pth
*.onnx
experiments/*/model.json
experiments/*/model.pkl
experiments/*/predictions.csv

# ============================================
# PYTHON
# ============================================
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.so

# ============================================
# VIRTUAL ENVIRONMENTS
# ============================================
.venv/
.venv312/
venv/
env/

# ============================================
# JUPYTER NOTEBOOKS
# ============================================
notebooks/.ipynb_checkpoints/
.ipynb_checkpoints/

# ============================================
# IDE / EDITOR
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ============================================
# OS FILES
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# LOGS
# ============================================
logs/
*.log
*.parquet.log.json

# ============================================
# SECRETS / CONFIG
# ============================================
.env
**/.env.*
data_config.json

# ============================================
# MISC
# ============================================
*.tar.gz
*.zip
wandb/data/processed/*.parquet
experiments/**/predictions.csv
experiments/*/predictions_seed*.csv

# ============================================
# PREDICTIONS / CHECKPOINTS / PARQUET (never committed)
# ============================================
experiments/**/predictions*.csv
*.parquet
*.ckpt
contract/out/*_dryrun*
docs/*_dryrun.json
external/
**/labels_*
**/*ground_truth*
.pgpass
*.password
*.passwd
*.secret
*.pem
*.key
password.txt
passwords.txt
platform/demo-credentials.txt
platform/out/demo/
**/*password*
**/*passwd*

# ============================================
# THIRD-PARTY CLONES (not vendored)
# ============================================
# MEGA-GNN (Apache-2.0). The exact upstream commit is recorded in
# experiments/R6_mega/config.yaml; re-clone it rather than committing a nested repo.
# third_party/shims/ IS ours and is committed.
third_party/mega_gnn/

data/raw*/
data/processed*/
experiments_li_small/

# Worktree convenience only: machine-absolute paths pointing at the primary checkout's
# data/ and experiments/ (both gitignored, so a worktree has neither). Create your own.
configs/paths_main.yaml

# ============================================
# ELLIPTIC — Phase 0-3 baselines (elliptic/)
# ============================================
# Its data lives under elliptic/data/, apart from the AMLworld pipeline's data/.
elliptic/data/
elliptic/experiments/*/model.ckpt
# Generated by elliptic/graph/viz_*_interactive.py next to elliptic/graph/lib/; open them locally.
elliptic/graph/*.html

# ============================================
# BUILD, TEST AND RUNTIME OUTPUT
# ============================================
.venv*/
venv-*/
node_modules/
test-results/
playwright-report/
platform/frontend/dist/
platform/out/

# ============================================
# EXCEPTIONS — committed files the broad rules above would hide
# ============================================
# Run-record sidecars that are committed on purpose (the parquet beside them is not).
!contract/out/**/*.parquet.log.json
!results/xai/**/*.parquet.log.json
!experiments_valrings/**/*.parquet.log.json
!experiments/R2_b0/gfpxgb/seed1/rings_cli.parquet.log.json
# Code and docs whose names contain a word the secret/data rules match.
!platform/adapters/ground_truth.py
!docs/RING_GROUND_TRUTH_DEFINITION.md
!platform/api/passwords.py
!platform/.env.example
# The IEEE-CIS scratch models, committed with Ruhani's Phase 0-3 work.
!elliptic/baselines/_ieee_cis_scratch/experiments/*/model.pkl
# L4 tenant runs for the other banks (scripts/demo.ps1 -AllRingBanks -FromProcessedData) are
# generated locally; banks 12 and 20 keep their committed L4 handoff records.
results/xai/tenant/**/*.parquet.log.json
!results/xai/tenant/**/*_12_*.parquet.log.json
!results/xai/tenant/**/*_20_*.parquet.log.json
